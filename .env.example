# Contact form — Resend integration
# 1. Sign up at https://resend.com (free tier: 100 emails/day)
# 2. Get your API key from https://resend.com/api-keys
# 3. Copy this file to ".env.local" and fill in the values
# 4. Add the same variables in Vercel → Project → Settings → Environment Variables

# Your Resend API key (required for the contact form to send email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address — must be a domain you verified in Resend.
# For testing only, "onboarding@resend.dev" works out of the box.
RESEND_FROM=onboarding@resend.dev

# Where the contact form delivers (defaults to your profile email if unset)
RESEND_TO=quadrisoliu14@gmail.com
